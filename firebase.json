{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
   "rewrites": [
  {
    "source": "/sitemap.xml",
    "function": "generateSitemap"
  },
  {
    "source": "/business/**",
    "function": "businessProfile"
  },
  {
    "source": "/hoi-an",
    "destination": "/category.html"
  },
  {
    "source": "/hoi-an/**",
    "destination": "/category.html"
  },
  {
    "source": "!/@(javascript|css|assets|images)/**",
    "destination": "/index.html"
  }
]
  }
}