{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/business/:slug",
        "function": "businessProfile"
      },
      {
        "source": "/sitemap.xml",
        "function": "generateSitemap"
      },
      {
        "source": "/:location/:category",
        "destination": "/category.html"
      },
      {
        "source": "/:location",
        "destination": "/category.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}